rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isPatient() { return signedIn() && myUser().data.role == 'patient'; }
    function isDoctor() { return signedIn() && myUser().data.role == 'doctor'; }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (userId == request.auth.uid || resource.data.role == 'doctor');
      allow update: if signedIn() && userId == request.auth.uid;
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow create: if isPatient() && request.resource.data.patientId == request.auth.uid;
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid);
      allow update: if isDoctor() && resource.data.doctorId == request.auth.uid
        && request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.status in ['confirmed', 'rejected'];
      allow delete: if false;
    }
  }
}
